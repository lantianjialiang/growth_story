{
  "name": "@growth/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed": "tsx src/seed.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@growth/shared": "*",
    "@hono/node-server": "^1.14.0",
    "@node-rs/argon2": "^2.0.2",
    "archiver": "^7.0.1",
    "better-sqlite3": "^11.8.1",
    "drizzle-orm": "^0.38.4",
    "exifr": "^7.1.3",
    "hono": "^4.6.20",
    "pino": "^9.6.0",
    "sharp": "^0.33.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "drizzle-kit": "^0.30.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
