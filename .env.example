# ===== 成长档案 · 环境变量示例 =====
# 复制为 .env（放在项目根目录或 apps/server 下），不要提交真实值

# 服务监听
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# 数据目录（SQLite 文件 + 上传的原图都在这里，备份只需要备份这个目录）
# 相对路径以 apps/server 为基准；绝对路径也可以
DATA_DIR=./data

# 会话
SESSION_TTL_DAYS=30
COOKIE_NAME=ga_session
# 生产环境走 HTTPS 时设为 1
COOKIE_SECURE=0

# 注册开关：家用建议建好账号后设为 0
ALLOW_REGISTRATION=1

# 如果你通过反向代理对外提供服务，填写外部访问地址（用于 CSRF Origin 校验）
# PUBLIC_ORIGIN=https://growth.example.com

# 单张图片大小上限（MB）
MAX_UPLOAD_MB=25

# 回收站保留天数
TRASH_RETENTION_DAYS=30

# 日志级别：fatal | error | warn | info | debug
LOG_LEVEL=info
